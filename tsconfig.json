{
  // Covers the server (src/), the spec and the scripts. The page's shared
  // module, public/recipes.js, is plain JS with JSDoc types: `allowJs` lets
  // the server import it with those types, without type-checking the page.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Imports name the file they mean, extension and all --- which is what
    // node itself wants when it runs a .ts file directly.
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "allowJs": true
  },
  "include": ["*.ts", "src", "spec", "scripts"],
  // Skyline's browser check, until the page's rewrite of it lands: it still
  // imports the deleted scripts/seed-demo.ts. Drop this line with that merge.
  "exclude": ["scripts/browser-check.ts"]
}
